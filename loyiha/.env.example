# Environment variables template for ICT-ML Trading System
# Copy this file to .env and fill in your actual values

# === API Configuration ===
# Binance API (required for live market data)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Bybit API (alternative exchange)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Exchange selection (BINANCE or BYBIT)
EXCHANGE=BINANCE

# === Telegram Bot Configuration ===
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your chat ID from @userinfobot or your bot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Admin ID (optional, defaults to TELEGRAM_CHAT_ID)
TELEGRAM_ADMIN_ID=your_telegram_admin_id_here

# === Dashboard Configuration ===
# Password for web dashboard authentication (minimum 16 characters recommended)
ADMIN_PASSWORD=your_secure_admin_password_here

# === Trading Configuration ===
# Initial balance for Prop Firm accounts (default: $50,000)
INITIAL_BALANCE=50000.0

# Default risk percentage per trade (default: 0.5%)
DEFAULT_RISK_PCT=0.5

# Enable live trading (DANGEROUS - set to true only when ready)
LIVE_TRADING_ENABLED=false

# === Scanner Configuration ===
# Scan interval in minutes (default: 15)
SCAN_INTERVAL_MINUTES=15

# === Webhook Configuration (for VPS production deployment) ===
# Set USE_WEBHOOK=true for production deployment
USE_WEBHOOK=false

# Your server URL (e.g., https://yourdomain.com)
WEBHOOK_URL=

# Webhook port (default: 8443)
WEBHOOK_PORT=8443

# Webhook listener (default: 0.0.0.0)
WEBHOOK_LISTEN=0.0.0.0

# === Database Configuration ===
DATABASE_URL=sqlite:///./signals.db

# === ML Model Configuration ===
ML_CONFIDENCE_THRESHOLD=0.80
